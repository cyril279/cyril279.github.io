[Unit]
Description=Samba
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=samba
Image=ghcr.io/servercontainers/samba:smbd-only-latest
AutoUpdate=registry
Network=host
UserNS=keep-id
User=root
Secret=smb_pass,type=env,target=ACCOUNT_cyril
EnvironmentFile=/home/containers/samba/quadlets/samba.env
Volume=/srv/media:/shares/media:z

[Service]
Restart=always

[Install]
WantedBy=default.target
